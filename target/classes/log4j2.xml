<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN"><Appenders>
<Console name="Console" target="SYSTEM_OUT"><PatternLayout pattern="%d{HH:mm:ss} %-5p %c{1} - %m%n"/></Console>
<RollingFile name="File" fileName="logs/career-quest.log" filePattern="logs/career-quest-%d{yyyy-MM-dd}-%i.log.gz">
<PatternLayout pattern="%d %-5p %c - %m%n"/><Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="10MB"/></Policies><DefaultRolloverStrategy max="5"/>
</RollingFile></Appenders><Loggers><Root level="info"><AppenderRef ref="Console"/><AppenderRef ref="File"/></Root></Loggers></Configuration>

